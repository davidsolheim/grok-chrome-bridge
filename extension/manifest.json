{
  "manifest_version": 3,
  "name": "Grok Chrome Bridge",
  "version": "1.0.0",
  "description": "Mark this Chrome profile as the one Grok Build should control.",
  "minimum_chrome_version": "144",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Grok Chrome Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
